<mxfile host="app.diagrams.net">
  <diagram name="Feed the Needy - AWS Architecture" id="arch1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== Lane labels ===================== -->
        <mxCell id="lbl1" value="Public web" style="text;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lbl2" value="WhatsApp pipeline" style="text;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lbl3" value="Data layer" style="text;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1080" y="20" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- ===================== External actors ===================== -->
        <mxCell id="visitor" value="Visitor" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="60" y="55" width="55" height="55" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="Admin" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="270" y="55" width="55" height="55" as="geometry" />
        </mxCell>
        <mxCell id="donor" value="Donor / Driver&#10;(WhatsApp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="55" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- ===================== Public web: landing ===================== -->
        <mxCell id="cf_landing" value="CloudFront&#10;(landing page)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== Public web: admin ===================== -->
        <mxCell id="cf_dash" value="CloudFront&#10;(admin dashboard)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1">
          <mxGeometry x="270" y="170" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value="Cognito&#10;(admin user pool)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1">
          <mxGeometry x="270" y="280" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="apigw_admin" value="API Gateway&#10;(admin API)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="270" y="390" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lambda_admin" value="Lambda&#10;listRequests · overrideAssign" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda_function;" vertex="1" parent="1">
          <mxGeometry x="270" y="500" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== WhatsApp pipeline ===================== -->
        <mxCell id="apigw_wa" value="API Gateway&#10;(WhatsApp webhook)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="680" y="170" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lambda_router" value="Lambda&#10;inbound router" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda_function;" vertex="1" parent="1">
          <mxGeometry x="680" y="280" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="guardrail" value="Bedrock Guardrail&#10;(prompt-attack + content filter)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="680" y="390" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nova" value="Bedrock · Nova Lite&#10;(classify + extract)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="680" y="500" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sfn" value="Step Functions&#10;(pickup state machine)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1">
          <mxGeometry x="680" y="610" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lambda_pipeline" value="Lambda (x6)&#10;match driver · notify · photo · match fridge · finalize" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda_function;" vertex="1" parent="1">
          <mxGeometry x="680" y="720" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eum" value="AWS End User&#10;Messaging Social" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_notification_service;" vertex="1" parent="1">
          <mxGeometry x="680" y="830" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- DLQ + alarm, offset to the right of the pipeline column -->
        <mxCell id="dlq" value="SQS&#10;WhatsApp send DLQ" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_queue_service;" vertex="1" parent="1">
          <mxGeometry x="860" y="940" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="alarm" value="CloudWatch&#10;alarm on queue depth" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="1040" y="940" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== Data layer ===================== -->
        <mxCell id="ddb" value="DynamoDB&#10;Requests · Drivers · Fridges · SpamLog · ProcessedMessages · DonationHistory" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#3334B9;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1180" y="170" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="S3&#10;pickup + fridge photos" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service_s3;" vertex="1" parent="1">
          <mxGeometry x="1180" y="330" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lambda_report" value="Lambda&#10;monthly report → CSV" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda_function;" vertex="1" parent="1">
          <mxGeometry x="1180" y="440" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== Edges ===================== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="visitor" target="cf_landing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1l" value="loads" style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="60" height="20" as="geometry" /></mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="admin" target="cf_dash"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="cf_dash" target="cognito"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3l" value="sign in" style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="250" width="60" height="20" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="cognito" target="apigw_admin"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4l" value="authorizes" style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="360" width="60" height="20" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="apigw_admin" target="lambda_admin"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5l" value="invokes" style="text;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="470" width="60" height="20" as="geometry" /></mxCell>

        <mxCell id="e6" value="POST message" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="donor" target="apigw_wa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="invokes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="apigw_wa" target="lambda_router"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="ApplyGuardrail" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#01A88D;" edge="1" parent="1" source="lambda_router" target="guardrail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="InvokeModel" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#01A88D;" edge="1" parent="1" source="guardrail" target="nova"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="starts execution" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="nova" target="sfn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="invokes each step" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="sfn" target="lambda_pipeline"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="SendWhatsAppMessage" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="lambda_pipeline" target="eum"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="delivers reply via Meta" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0;entryX=1;entryY=0.5;rounded=1;" edge="1" parent="1" source="eum" target="donor"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="860" /><mxPoint x="900" y="82" /></Array></mxGeometry></mxCell>

        <mxCell id="e14" value="on failure" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;dashed=1;" edge="1" parent="1" source="eum" target="dlq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="queue depth" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;dashed=1;" edge="1" parent="1" source="dlq" target="alarm"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e16" value="read / write Requests" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;rounded=1;" edge="1" parent="1" source="lambda_admin" target="ddb">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="40" /><mxPoint x="1210" y="40" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="e17" value="read Drivers / Fridges, write Requests" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;rounded=1;" edge="1" parent="1" source="lambda_pipeline" target="ddb">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="750" /><mxPoint x="820" y="200" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e18" value="store photos" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;rounded=1;" edge="1" parent="1" source="lambda_pipeline" target="s3">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="770" /><mxPoint x="850" y="360" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="e19" value="scheduled read" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;rounded=1;" edge="1" parent="1" source="ddb" target="lambda_report">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="230" /><mxPoint x="1300" y="470" /></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
